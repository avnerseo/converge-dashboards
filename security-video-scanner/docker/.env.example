# Copy to .env next to docker-compose.yml and edit.

# First-run administrator. Delete this line once the account exists.
VSCAN_ADMIN_USER=admin
VSCAN_ADMIN_PASSWORD=change-this-now-please

# Where the recordings live on the host (mounted read-only at /footage)
VSCAN_FOOTAGE_PATH=./footage

# Bind address. Keep 127.0.0.1 and put a TLS reverse proxy in front;
# use 0.0.0.0 only on a trusted, isolated network.
VSCAN_BIND=127.0.0.1

# Set to true when the app is served over HTTPS (marks the session cookie secure)
VSCAN_SECURE_COOKIE=false

# Indexing workers. Roughly one CPU core each.
VSCAN_WORKERS=2
VSCAN_CPUS=4

# Delete indexed biometric data older than this many days (0 = keep until purged)
VSCAN_RETENTION_DAYS=0

# Natural-language search sends frames to the Claude API. Off by default.
VSCAN_ASK_ENABLED=false
ANTHROPIC_API_KEY=

# Preview transcode codec: auto | h264 | vp9 | vp8
VSCAN_PREVIEW_CODEC=auto
